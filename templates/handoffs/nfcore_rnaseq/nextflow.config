workDir = System.getenv('NXF_WORK') ?: 'jobs/<job_id>/work/nfcore_rnaseq'

process {
  executor = 'slurm'
  queue = System.getenv('ULTIMATE_SLURM_PARTITION') ?: 'compute_pro'
  cpus = 8
  memory = '48 GB'
  time = '24h'
  errorStrategy = 'retry'
  maxRetries = 1
  scratch = false
}

apptainer {
  enabled = true
  autoMounts = true
  cacheDir = 'containers/apptainer'
}

timeline {
  enabled = true
  file = 'jobs/<job_id>/runs/nfcore_rnaseq/pipeline_info/timeline.html'
}

report {
  enabled = true
  file = 'jobs/<job_id>/runs/nfcore_rnaseq/pipeline_info/report.html'
}

trace {
  enabled = true
  file = 'jobs/<job_id>/runs/nfcore_rnaseq/pipeline_info/trace.txt'
}

dag {
  enabled = true
  file = 'jobs/<job_id>/runs/nfcore_rnaseq/pipeline_info/dag.html'
}
